@@ -68,6 +68,14 @@
 #include <sys/pciio.h>
 #endif
 
+#if defined(__sun)
+/*
+ * illumos: DRM drivers have dynamic majors and clone every open, and the
+ * device information comes from libdevinfo.  See sun_devinfo.c.
+ */
+#include "sun_devinfo.h"
+#endif
+
 #define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
 
 /* Not all systems have MAP_FAILED defined */
@@ -964,6 +972,13 @@
     char buf[DRM_NODE_NAME_MAX];
     const char *dev_name = drmGetDeviceName(type);
 
+#if defined(__sun)
+    /*
+     * devfsadm(8) makes the /dev/dri links and the majors are dynamic:
+     * open the node if it is there, never create one.
+     */
+    create = 0;
+#endif
     if (create)
         return drmOpenDevice(makedev(DRM_MAJOR, minor), minor, type);
 
@@ -1030,6 +1045,9 @@
 
 static int drmGetMinorType(int major, int minor)
 {
+#if defined(__sun)
+    return drmSunMinorType(major, minor);
+#endif
 #ifdef __FreeBSD__
     char name[SPECNAMELEN];
     int id;
@@ -1638,7 +1656,11 @@
     drm_map_t map;
 
     memclear(map);
+#if defined(__sun)
+    map.handle = handle;
+#else
     map.handle = (void *)(uintptr_t)handle;
+#endif
 
     if(drmIoctl(fd, DRM_IOCTL_RM_MAP, &map))
         return -errno;
@@ -3295,6 +3317,16 @@
     min = minor(sbuf.st_rdev);
     nodetype = drmGetMinorType(maj, min);
     return drmGetMinorNameForFD(fd, nodetype);
+#elif defined(__sun)
+    struct stat sbuf;
+
+    if (fstat(fd, &sbuf) || !S_ISCHR(sbuf.st_mode))
+        return NULL;
+    /* As on Linux, only a primary node has a name here. */
+    if (drmSunMinorType(major(sbuf.st_rdev), minor(sbuf.st_rdev)) !=
+        DRM_NODE_PRIMARY)
+        return NULL;
+    return drmSunNodeName(sbuf.st_rdev, -1);
 #else
     char name[128];
     struct stat sbuf;
@@ -3340,6 +3372,8 @@
      * in /dev/drm/ and links in /dev/dri while a WIP in kernel driver creates
      * only device nodes in /dev/dri/ */
     return (!strncmp(name, "drm/", 4) || !strncmp(name, "dri/", 4));
+#elif defined(__sun)
+    return drmSunNodeIsDRM(maj, min);
 #else
     return maj == DRM_MAJOR;
 #endif
@@ -3496,6 +3530,18 @@
          id + drmGetMinorBase(type));
 
     return strdup(name);
+#elif defined(__sun)
+    struct stat sbuf;
+
+    if (fstat(fd, &sbuf))
+        return NULL;
+
+    if (!drmNodeIsDRM(major(sbuf.st_rdev), minor(sbuf.st_rdev)) ||
+        !S_ISCHR(sbuf.st_mode))
+        return NULL;
+
+    /* The node of that type of the same device, from /dev/dri. */
+    return drmSunNodeName(sbuf.st_rdev, type);
 #else
     struct stat sbuf;
     char buf[PATH_MAX + 1];
@@ -3641,6 +3687,8 @@
     return subsystem_type;
 #elif defined(__OpenBSD__) || defined(__DragonFly__) || defined(__FreeBSD__)
     return DRM_BUS_PCI;
+#elif defined(__sun)
+    return drmSunSubsystemType(maj, min);
 #else
 #warning "Missing implementation of drmParseSubsystemType"
     return -EINVAL;
@@ -3773,6 +3821,8 @@
     return 0;
 #elif defined(__FreeBSD__)
     return get_sysctl_pci_bus_info(maj, min, info);
+#elif defined(__sun)
+    return drmSunPciBusInfo(maj, min, info);
 #else
 #warning "Missing implementation of drmParsePciBusInfo"
     return -EINVAL;
@@ -3985,6 +4035,9 @@
     device->revision_id = results[0].pc_revid;
 
     return 0;
+#elif defined(__sun)
+    /* The revision is a devinfo property: always filled in. */
+    return drmSunPciDeviceInfo(maj, min, device);
 #else
 #warning "Missing implementation of drmParsePciDeviceInfo"
     return -EINVAL;
@@ -4485,6 +4538,8 @@
     fullname[DRM_FAUX_DEVICE_NAME_LEN - 1] = '\0';
 
     return 0;
+#elif defined(__sun)
+    return drmSunFauxBusInfo(maj, min, fullname, DRM_FAUX_DEVICE_NAME_LEN);
 #else
 #warning "Missing implementation of drmParseFauxBusInfo"
     return -EINVAL;
@@ -4617,9 +4672,15 @@
 
     for (int i = 0; i < DRM_NODE_MAX; i++) {
         if (device->available_nodes & 1 << i) {
+#if defined(__sun)
+            if (stat(device->nodes[i], &sbuf) == 0 &&
+                drmSunSameNode(sbuf.st_rdev, find_rdev))
+                return true;
+#else
             if (stat(device->nodes[i], &sbuf) == 0 &&
                 sbuf.st_rdev == find_rdev)
                 return true;
+#endif
         }
     }
     return false;
@@ -4941,6 +5002,17 @@
     return strdup(path);
 #elif defined(__FreeBSD__)
     return drmGetDeviceNameFromFd(fd);
+#elif defined(__sun)
+    struct stat sbuf;
+
+    if (fstat(fd, &sbuf))
+        return NULL;
+
+    if (!drmNodeIsDRM(major(sbuf.st_rdev), minor(sbuf.st_rdev)) ||
+        !S_ISCHR(sbuf.st_mode))
+        return NULL;
+
+    return drmSunNodeName(sbuf.st_rdev, -1);
 #else
     struct stat      sbuf;
